class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None



def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)

    elif data > root.data:
        root.right = insert(root.right, data)

    return root



def level_order(root):
    if root is None:
        return

    queue = []
    queue.append(root)

    while len(queue) != 0:
        temp = queue.pop(0)

        print(temp.data, end=" ")

        if temp.left is not None:
            queue.append(temp.left)

        if temp.right is not None:
            queue.append(temp.right)



def copy_tree(root):
    if root is None:
        return None

    new_root = Node(root.data)

    new_root.left = copy_tree(root.left)
    new_root.right = copy_tree(root.right)

    return new_root



def height(root):
    if root is None:
        return 0

    left_height = height(root.left)
    right_height = height(root.right)

    if left_height > right_height:
        return left_height + 1
    else:
        return right_height + 1



def leaf_nodes(root):
    if root is None:
        return

    if root.left is None and root.right is None:
        print(root.data, end=" ")

    leaf_nodes(root.left)
    leaf_nodes(root.right)



root = None

n = int(input("Enter number of nodes: "))

print("Enter BST nodes:")

for i in range(n):
    x = int(input())
    root = insert(root, x)



print("\nOriginal BST - Level Order:")
level_order(root)



new_root = copy_tree(root)

print("\nCopied BST - Level Order:")
level_order(new_root)



print("\nHeight of BST:", height(root))



print("Leaf Nodes:")
leaf_nodes(root)
