class Node:
    def __init__(self, rollno, name):
        self.rollno = rollno
        self.name = name
        self.left = None
        self.right = None


def insert(root, rollno, name):
    newnode = Node(rollno, name)

    if root is None:
        return newnode

    temp = root

    while True:

        if rollno < temp.rollno:

            if temp.left is None:
                temp.left = newnode
                break
            else:
                temp = temp.left

        else:

            if temp.right is None:
                temp.right = newnode
                break
            else:
                temp = temp.right

    return root


def inorder(root):
    if root is None:
        return

    inorder(root.left)

    print(root.rollno, root.name)

    inorder(root.right)


