class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None


def inorder(root):
    if root is not None:
        inorder(root.left)
        print(root.data, end=" ")
        inorder(root.right)


def preorder(root):
    if root is not None:
        print(root.data, end=" ")
        preorder(root.left)
        preorder(root.right)


root = Node("Library")

root.left = Node("Science")
root.right = Node("Technology")

root.left.left = Node("Physics")
root.left.right = Node("Chemistry")

root.right.left = Node("Python")
root.right.right = Node("DSA")


print("Library Catalog - Inorder:")
inorder(root)

print("\nLibrary Catalog - Preorder:")
preorder(root)
